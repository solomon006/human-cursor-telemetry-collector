# Project data and logs
/dataset/
/raw_sessions/
*.log

# Python ignores
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Archives
*.zip
*.tar
*.tar.gz
*.rar
